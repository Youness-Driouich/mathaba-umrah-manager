# ==============================================================================
# Supabase PostgreSQL Configuration (Managed Cloud Database)
# ==============================================================================
# 1. Transaction Pooler URL (Port 6543) - Used by Next.js runtime queries
# In Supabase: Project Settings -> Database -> Connection string -> Prisma
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct Connection URL (Port 5432) - Used by Prisma CLI for migrations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ==============================================================================
# Authentication & Security Secrets
# ==============================================================================
AUTH_SECRET="super-secret-mathaba-umrah-key-change-in-production-2026"
NEXTAUTH_URL="http://localhost:3000"

# Initial Administrator Credentials (seeded into Supabase on first run)
INITIAL_ADMIN_EMAIL="admin@mathaba.agency"
INITIAL_ADMIN_PASSWORD="Admin@Mathaba2026!"
INITIAL_ADMIN_NAME="Mathaba Agency Director"

# Application Environment
NODE_ENV="development"
