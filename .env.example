# ==============================================================================
# Neon PostgreSQL Configuration (Managed Serverless Cloud Database)
# ==============================================================================
# In Neon Console (Dashboard -> Connection Details -> Prisma):
# 1. Pooled connection string (with -pooler) for runtime application queries:
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT]-pooler.[REGION].aws.neon.tech/[DBNAME]?sslmode=require"

# 2. Direct connection string (without -pooler) for Prisma CLI schema migrations:
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].[REGION].aws.neon.tech/[DBNAME]?sslmode=require"

# ==============================================================================
# Authentication & Security Secrets
# ==============================================================================
AUTH_SECRET="super-secret-mathaba-umrah-key-change-in-production-2026"
NEXTAUTH_URL="http://localhost:3000"

# Initial Administrator Credentials (seeded into Neon on first run)
INITIAL_ADMIN_EMAIL="admin@mathaba.agency"
INITIAL_ADMIN_PASSWORD="Admin@Mathaba2026!"
INITIAL_ADMIN_NAME="Mathaba Agency Director"

# Application Environment
NODE_ENV="development"
